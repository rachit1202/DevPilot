{
  "name": "devpilot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DevPilot — AI-powered social media command center",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env ./node_modules/ts-node/dist/bin.js --transpile-only prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "npm run --workspaces --if-present lint",
    "test:e2e": "playwright test",
    "typecheck": "npm run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.14.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3"
  }
}
