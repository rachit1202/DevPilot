{
  "name": "@devpilot/api",
  "version": "1.0.0",
  "private": true,
  "description": "DevPilot — Fastify Backend API Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file=../../.env ../../node_modules/ts-node/dist/bin.js --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node --env-file=../../.env dist/index.js",
    "test": "node --env-file=../../.env ../../node_modules/ts-node/dist/bin.js --transpile-only test/auth.test.ts",
    "test:content-media": "node --env-file=../../.env ../../node_modules/ts-node/dist/bin.js --transpile-only test/content-media.test.ts",
    "test:hardening": "node --env-file=../../.env ../../node_modules/ts-node/dist/bin.js --transpile-only test/workflow-hardening.test.ts",
    "test:all": "node --env-file=../../.env ../../node_modules/ts-node/dist/bin.js --transpile-only test/auth.test.ts && node --env-file=../../.env ../../node_modules/ts-node/dist/bin.js --transpile-only test/content-media.test.ts && node --env-file=../../.env ../../node_modules/ts-node/dist/bin.js --transpile-only test/workflow-hardening.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devpilot/shared": "*",
    "@devpilot/validation": "*",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
