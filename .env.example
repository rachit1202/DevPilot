# ==============================================================================
# DevPilot — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the repository root and customize values as needed.
# All paths and secrets below use safe development defaults.

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string consumed by Prisma and backend services.
# Standard local default port is 5432; adjust if running on an alternative port (e.g. 5433).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devpilot?schema=public"

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# ------------------------------------------------------------------------------
# Rate Limiting Configuration
# ------------------------------------------------------------------------------
# Maximum requests allowed within the rate-limit window (1 minute)
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_MAX=120

# ------------------------------------------------------------------------------
# Authentication Secrets
# ------------------------------------------------------------------------------
# Both keys must be at least 32 characters long.
# Change these to strong random strings in any non-local or production environment.
JWT_SECRET="devpilot-local-jwt-super-secret-key-change-in-production-min32chars"
COOKIE_SECRET="devpilot-local-cookie-secret-key-min32chars"

# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
# STORAGE_DIR is the single authoritative storage root for DevPilot.
# AI engine locks (ai-engine.pid, ai-recovery.lock) and media uploads reside here.
# Relative paths resolve deterministically against the monorepo root.
STORAGE_DIR="./storage"

# Note: Media uploads are automatically stored in <STORAGE_DIR>/uploads.
# The UPLOAD_DIR entry below is supported for backward-compatible schema parsing.
UPLOAD_DIR="./storage/uploads"

# ------------------------------------------------------------------------------
# AI Studio & Ollama Configuration
# ------------------------------------------------------------------------------
# URL of the local Ollama instance (default loopback port is 11434).
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Local SLM model for text, carousel, and reel generation (must be pulled in Ollama).
OLLAMA_MODEL="qwen2.5:3b"

# Inference timeout in milliseconds. Must be an integer between 60000 (1 min) and 300000 (5 mins).
OLLAMA_TIMEOUT_MS=120000

# Loopback TCP port for kernel-backed single-process AI engine mutual exclusion.
# Default: 54321. Must be an integer between 1 and 65535.
AI_LOCK_PORT=54321

# ------------------------------------------------------------------------------
# Initial Bootstrap Credentials (used exclusively by prisma/seed.ts)
# ------------------------------------------------------------------------------
INITIAL_OWNER_NAME="CodeCulture Admin"
INITIAL_OWNER_EMAIL="admin@codeculture.dev"
INITIAL_OWNER_PASSWORD="ChangeMeInLocalDev123!"
